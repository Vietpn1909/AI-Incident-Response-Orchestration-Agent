# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
#
# Dùng thư viện langchain-openai cho MỌI provider có endpoint tương thích
# OpenAI. Đổi provider = đổi 3 biến dưới đây, KHÔNG sửa code.
#
# Alibaba Cloud Model Studio (DashScope) — đội đang dùng, có quota miễn phí:
OPENAI_API_KEY=sk-your-key-here
LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-plus
#
# Nếu ở Trung Quốc đại lục thì đổi endpoint:
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#
# Nếu dùng OpenAI thì để LLM_BASE_URL trống và MODEL_NAME=gpt-4o-mini
#
# Chẩn đoán cần ổn định để đo được độ chính xác trong eval/ — nhiệt độ cao làm
# cùng một bằng chứng ra kết luận khác nhau mỗi lần chạy.
LLM_TEMPERATURE=0.2

# ---- Database: lịch sử deploy (nguồn bằng chứng cho correlate_deploy) ----
# Đây là Postgres của demo/, nơi demo/seed.py sinh bảng deploy_history.
# KHÔNG phải database của app — chỉ services/deploys.py đọc biến này.
#
# Để nguyên placeholder hoặc trỏ sang sqlite thì đối chiếu deploy im lặng không
# chạy: giả thuyết mất bằng chứng deploy và độ tin cậy tụt từ 90% xuống 40%.
DATABASE_URL=postgresql://demo:demo@localhost:5432/demo
#
# Máy đã có Postgres native chiếm 5432 thì đổi cổng ở CẢ HAI chỗ:
#   DEMO_POSTGRES_PORT=55432 docker compose -f docker-compose.demo.yml up -d
#   DATABASE_URL=postgresql://demo:demo@localhost:55432/demo

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Auto-Remediation Timeout (mặc định TẮT) ----
# Bật = Agent tự sửa nếu 30 phút không có người phản hồi
# P3/P4: dùng đúng hành động đã đề xuất
# P1/P2: ép rollback về version trước
# AUTO_REMEDIATION_ENABLED=1
# AUTO_REMEDIATION_TIMEOUT_MINUTES=30

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=f3p1dEOhD_z8qjjtbeCtb2t9ASMEliz-4juZfWe3ZPgCtPZp-LjWthBfeNU8d5dP
AI_LOG_DIR=.ai-log

# ---- Email (Postmortem report — Gmail SMTP + App Password) ----
# Tạo App Password: https://myaccount.google.com/apppasswords (cần bật 2FA)
SMTP_EMAIL=
SMTP_APP_PASSWORD=
# Danh sách email nhận Postmortem (mail gửi SAU KHI xong), phân cách bằng phẩy:
POSTMORTEM_RECIPIENTS=
#
# Người nhận cảnh báo lúc PHÁT HIỆN sự cố — mail này kèm link phòng họp để bấm
# vào là tham gia được. Khác nhóm với POSTMORTEM_RECIPIENTS: đây là người phải
# vào sửa ngay, kia là người đọc báo cáo hôm sau.
# Để trống thì dùng lại POSTMORTEM_RECIPIENTS.
INCIDENT_ALERT_RECIPIENTS=

# ---- Phòng họp khẩn (Daily.co) ----
# Lấy key: daily.co → Dashboard → Developers (free 10.000 phút/tháng)
#
# Không dùng Google Meet: Meet REST API chỉ nhận OAuth 2.0 user auth (API key bị
# từ chối), và refresh token ở chế độ Testing hết hạn sau 7 ngày.
# Để trống thì war room vẫn mở bình thường, chỉ không kèm link họp.
DAILY_API_KEY=

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
